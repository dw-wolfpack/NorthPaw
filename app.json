{
  "expo": {
    "name": "NorthPaw",
    "slug": "northpaw",
    "version": "5.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "northpaw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.northpaw.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.northpaw.app"
        ]
      },
      "appleTeamId": "5V6Q478U5L"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.northpaw.app",
      "versionCode": 11,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NorthPaw to scan QR codes that open field cards, checklists, and packs in the app.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NorthPaw to choose a dog photo for Home and to attach photos to private outing logs. Images stay on this device.",
          "cameraPermission": "Allow NorthPaw to take a photo for a private outing log."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NorthPaw uses your location for local US weather on Home and for optional GPS on outing logs. Coordinates are sent only to api.weather.gov for weather."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26946416-fc70-4522-9d65-02746eae4ca7",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.northpaw.app.widget",
                  "targetName": "NorthPawWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.northpaw.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
